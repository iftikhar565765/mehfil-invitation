{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehfil-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mehfil-invitations",
      "database_id": "b78fc1f0-1052-4afb-b8f4-45e0648ae311"
    }
  ]
}
